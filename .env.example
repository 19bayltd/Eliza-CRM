# Eliza OS environment variables — NAMES ONLY, never commit real values.
# Local development and Vercel preview use the STAGING Supabase project.
# Vercel production uses the PRODUCTION Supabase project (owner-managed).

# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=

# Server-only. NEVER prefix with NEXT_PUBLIC_. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Integration tests only (optional; CI/staging)
# SUPABASE_TEST_USER_EMAIL=
# SUPABASE_TEST_USER_PASSWORD=
